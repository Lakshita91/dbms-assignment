-- 1. Display first and last names with aliases.
SELECT first_name AS `First Name`,
       last_name AS `Last Name`
FROM employees;

-- 2. Get unique department IDs.
SELECT DISTINCT department_id
FROM employees;

-- 3. Get all employee details ordered by first name, descending.
SELECT *
FROM employees
ORDER BY first_name DESC;

-- 4. Display names, salary, and PF (15% of salary).
SELECT first_name,
       last_name,
       salary,
       salary * 0.15 AS PF
FROM employees;

-- 5. Employee ID, names, and salary in ascending salary order.
SELECT employee_id,
       first_name,
       last_name,
       salary
FROM employees
ORDER BY salary ASC;

-- 6. Total salaries payable to employees.
SELECT SUM(salary) AS total_salary
FROM employees;

-- 7. Maximum and minimum salary.
SELECT MAX(salary) AS maximum_salary,
       MIN(salary) AS minimum_salary
FROM employees;

-- 8. Average salary and number of employees.
SELECT AVG(salary) AS average_salary,
       COUNT(*) AS number_of_employees
FROM employees;

-- 9. Number of employees in the company.
SELECT COUNT(*) AS total_employees
FROM employees;

-- 10. Number of distinct jobs represented in the employees table.
SELECT COUNT(DISTINCT job_id) AS number_of_jobs
FROM employees;

-- 11. First names in uppercase.
SELECT UPPER(first_name) AS first_name_uppercase
FROM employees;

-- 12. First three characters of each first name.
SELECT SUBSTRING(first_name, 1, 3) AS first_three_characters
FROM employees;


-- 13. Calculate 171 * 214 + 625.
SELECT 171 * 214 + 625 AS result;
-- Expected result: 37219

-- 14. Display full employee names, e.g. Ellen Abel.
SELECT CONCAT(first_name, ' ', last_name) AS employee_name
FROM employees;

-- 15. Remove whitespace from both ends of first_name.
SELECT TRIM(first_name) AS first_name_trimmed
FROM employees;

-- 16. Length of each employee's full name.
SELECT first_name,
       last_name,
       CHAR_LENGTH(CONCAT(first_name, ' ', last_name)) AS employee_name_length
FROM employees;

-- 17. Check whether first_name contains any digit.
SELECT first_name,
       CASE
           WHEN first_name REGEXP '[0-9]' THEN 'Contains number'
           ELSE 'Does not contain number'
       END AS number_check
FROM employees;

-- 18. Select the first 10 records.
SELECT *
FROM employees
LIMIT 10;

-- 19. Calculate monthly salary from annual salary, rounded to 2 decimal places.
SELECT employee_id,
       first_name,
       last_name,
       ROUND(salary / 12, 2) AS monthly_salary
FROM employees;
